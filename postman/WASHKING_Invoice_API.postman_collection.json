            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"{{customerId}}\",\n  \"invoice_number\": \"INV-{{$timestamp}}\",\n  \"total_amount\": 5000,\n  \"due_date\": \"2026-12-31\",\n  \"initial_deposit\": 1000,\n  \"deposit_method\": \"Cash\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const inv = pm.response.json();",
                  "pm.collectionVariables.set(\"invoiceId\", inv.id);",
                  "pm.collectionVariables.set(\"invoiceNumber\", inv.invoice_number);",
                  "pm.test(\"Deposit counted: paid 1000, balance 4000, partially paid\", () => { pm.expect(inv.total_paid).to.eql(1000); pm.expect(inv.outstanding_balance).to.eql(4000); pm.expect(inv.status).to.eql(\"PARTIALLY_PAID\"); });"
                ]
